NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
NEXT_PUBLIC_SUPABASE_URL=""
# Google Analytics 4 Measurement ID, e.g. G-XXXXXXXXXX (leave empty to disable tracking)
NEXT_PUBLIC_GA_ID=""
# Meta (Facebook) Pixel ID (leave empty to disable tracking)
NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads Enhanced Conversions — account-level conversion ID, e.g. AW-XXXXXXXXX
NEXT_PUBLIC_ADS_CONVERSION_ID=
# Per-conversion-action labels (the part after the slash in AW-XXXX/LABEL).
# Each event silently no-ops until its label is set.
NEXT_PUBLIC_ADS_LABEL_PURCHASE=
NEXT_PUBLIC_ADS_LABEL_SIGNUP=
NEXT_PUBLIC_ADS_LABEL_CONTACT=
NEXT_PUBLIC_ADS_LABEL_BOOKING=
# Tracked redirect routes: /whatsapp and /maps
NEXT_PUBLIC_ADS_LABEL_WHATSAPP=
NEXT_PUBLIC_ADS_LABEL_MAPS=

# /whatsapp — destination. Digits only with country code, no "+".
NEXT_PUBLIC_WHATSAPP_PHONE=917729900091
# Message prefilled for the guest to send.
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hello

# /maps — destination. Address used as the Google Maps search query.
NEXT_PUBLIC_MAPS_QUERY="Euro Hotel, Opp Post Office, Mumbai Highway, Rudraram Village, Patancheru Mandal, Sangareddy Dist, Telangana 502329"
# Optional but recommended — pins the exact place instead of resolving the address text.
# Find it at https://developers.google.com/maps/documentation/places/web-service/place-id
NEXT_PUBLIC_MAPS_PLACE_ID=
