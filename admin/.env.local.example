# Supabase (copy from backend .env / frontend .env)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Backend API URL
BACKEND_URL=http://localhost:8000

# ImageKit — used to upload dish images from the Menu page.
# Dashboard → Developer Options → API Keys. Keep the private key server-side only.
IMAGEKIT_PRIVATE_KEY=private_xxxxxxxxxxxxxxxxxxxxxxxx
# Optional — folder new dish images land in (defaults to /menu)
IMAGEKIT_MENU_FOLDER=/menu
